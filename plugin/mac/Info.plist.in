	<string>OneEighty</string>
	<key>CFBundleDisplayName</key>
	<string>OneEighty Motion Blur</string>
	<key>CFBundlePackageType</key>
	<string>eFKT</string>
	<key>CFBundleSignature</key>
	<string>FXTC</string>
